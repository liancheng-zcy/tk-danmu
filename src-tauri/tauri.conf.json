{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TK 弹幕翻译",
  "version": "0.1.1",
  "identifier": "com.tk-danmu-translator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TK 弹幕翻译",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "externalBin": ["binaries/node"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": ["../worker/bundle/**/*"]
  }
}
